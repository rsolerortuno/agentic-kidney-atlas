runs/2026-11-01/agent_omics.json text eol=lf
runs/2026-11-01/basis.json -text
runs/2026-11-01/narrative.json text eol=lf
src/ccrcc/reference_data/degradation.json text eol=lf
src/ccrcc/reference_data/literature_review.json text eol=lf
src/ccrcc/report_assets/3Dmol-min.js text eol=lf
src/ccrcc/report_assets/3Dmol-source.json text eol=lf
evals/qa.yaml text eol=lf
evals/qa_answers.json text eol=lf
evals/baselines/closed_book_1.json text eol=lf
evals/baselines/closed_book_2.json text eol=lf
evals/baselines/closed_book_3.json text eol=lf
