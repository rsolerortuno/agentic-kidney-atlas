{% from "macros.j2" import q, plot %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ccRCC Target Atlas</title>
<style>
:root{
  color-scheme:light;
  --bg:#fbfbfa;--surface:#ffffff;--ink:#1c1c1b;--ink2:#4d4c49;--muted:#85837d;--line:#e6e5e0;--axis:#c9c8c0;
  --s1:#2a78d6;--s2:#eb6834;--s3:#1baf7a;--s4:#eda100;--s5:#e87ba4;--s6:#008300;--s7:#6250d6;--s8:#e34948;
  --chip:#f1f0ec;--good:#006300;--warn:#8a5a00;--bad:#b02e2e;--shadow:0 1px 2px rgba(28,28,27,.05);
  --grid:rgba(137,135,129,.22);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--s1)}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px}
.top{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px;padding:12px 0 6px}
.brand h1{font-size:1.05rem;margin:0;font-weight:650;letter-spacing:-.01em}
.brand .sub{color:var(--muted);font-size:.8rem;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.themebtn{border:1px solid var(--line);background:var(--surface);color:var(--ink2);border-radius:8px;padding:5px 10px;font:inherit;font-size:.8rem;cursor:pointer}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{appearance:none;background:none;border:0;border-bottom:2px solid transparent;color:var(--ink2);font:inherit;font-size:.88rem;font-weight:550;padding:9px 13px;cursor:pointer;white-space:nowrap}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--s1)}
.tab .n{font-size:.7rem;background:var(--chip);color:var(--muted);border-radius:99px;padding:1px 7px;margin-left:5px}
.panel{display:none;padding:26px 0 60px}
.panel.on{display:block}
h2{font-size:1.25rem;margin:1.6em 0 .4em;letter-spacing:-.01em}
h2:first-child{margin-top:0}
h3{font-size:.98rem;margin:1.2em 0 .3em}
.lede{color:var(--ink2);max-width:80ch;margin:.2em 0 1em}
.small{font-size:.82rem;color:var(--muted);line-height:1.5}
.claim{margin:.55em 0;max-width:92ch}
.cite{color:var(--s1);text-decoration:none;font-size:.7rem;font-weight:600}
.cite:hover{text-decoration:underline}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow)}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))}
.grid.two{grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr))}
.kpis{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin:0 0 22px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.kpi b{display:block;font-size:1.65rem;line-height:1.15;letter-spacing:-.02em}
.kpi span{color:var(--muted);font-size:.78rem}
.tag{display:inline-block;font-size:.68rem;font-weight:600;padding:2px 8px;border-radius:99px;background:var(--chip);color:var(--ink2);margin:0 4px 2px 0;white-space:nowrap}
.tag.t{background:var(--s1);color:#fff}.tag.b{background:var(--s2);color:#fff}.tag.tb{background:linear-gradient(90deg,var(--s1),var(--s2));color:#fff}
.tag.tumor{background:var(--s1);color:#fff}.tag.stroma{background:var(--s2);color:#fff}.tag.immune{background:var(--s3);color:#fff}
.tag.fic{background:var(--good);color:#fff}
.tag.warn{background:transparent;border:1px solid var(--warn);color:var(--warn)}
.cand h3{margin:.1em 0 .35em;font-size:1.05rem}
.cand .meta{display:flex;flex-wrap:wrap;gap:4px;margin:.2em 0 .5em}
.cand p{margin:.3em 0;font-size:.88rem;color:var(--ink2)}
.score{display:inline-block;height:7px;border-radius:4px;background:var(--s1);vertical-align:middle;margin-right:6px}
.note{border-left:3px solid var(--s4);background:var(--chip);padding:10px 14px;border-radius:0 8px 8px 0;font-size:.88rem;color:var(--ink2);margin:14px 0}
.note.bad{border-left-color:var(--s8)}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:.82rem}
th,td{padding:7px 10px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:600;background:var(--surface);white-space:nowrap}
tr:last-child td{border-bottom:0}
td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tbody tr:hover{background:var(--chip)}
.filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0}
.chip{border:1px solid var(--line);background:var(--surface);color:var(--ink2);border-radius:99px;padding:4px 12px;font:inherit;font-size:.8rem;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--s1);border-color:var(--s1);color:#fff}
.search{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;padding:6px 10px;font:inherit;font-size:.85rem;min-width:200px}
.plot{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:6px;min-width:0}
#cy{height:600px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
.ev{font-size:.8rem;border-bottom:1px dashed var(--line);padding:6px 0;line-height:1.45}
.ev code{font-size:.7rem;color:var(--muted)}
.ev:target{background:color-mix(in srgb,var(--s4) 22%,transparent)}
ul.roadmap li{margin:.5em 0;max-width:90ch}
footer{color:var(--muted);font-size:.8rem;padding:10px 0 50px;border-top:1px solid var(--line)}

.q{width:22px;height:22px;border-radius:50%;border:1px solid var(--axis);background:var(--surface);color:var(--ink2);font:600 .75rem/1 system-ui;cursor:pointer;padding:0;margin-left:8px;vertical-align:middle}
.q:hover,.q[aria-expanded="true"]{background:var(--s1);border-color:var(--s1);color:#fff}
.plot,.kpi,.card{position:relative}
.plot-q{position:absolute;top:8px;right:8px;z-index:5}
.kpi .q{position:absolute;top:8px;right:8px;margin:0}
.helpbox{background:var(--chip);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin:8px 0;font-size:.85rem;color:var(--ink2);line-height:1.55;text-align:left;font-weight:400;letter-spacing:0}
.helpbox p{margin:.3em 0}.helpbox b{color:var(--ink)}
.whatsnew{border:1px solid var(--line);border-left:4px solid var(--s1);background:var(--surface);border-radius:10px;padding:14px 18px;margin:0 0 22px}
.whatsnew h3{margin:.1em 0 .5em}.whatsnew ul{margin:.3em 0 0 1.1em;padding:0}.whatsnew li{margin:.35em 0;max-width:95ch}
.vwrap{display:grid;gap:14px;grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr)}
@media (max-width:900px){.vwrap{grid-template-columns:1fr}}
.vctl{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:10px 0}
.vctl label{font-size:.8rem;color:var(--muted)}
.vctl select,.vctl input[type=range]{font:inherit;font-size:.85rem}
.vctl select{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;padding:5px 8px}
#vcanvas{width:100%;border:1px solid var(--line);border-radius:12px;background:var(--surface);cursor:crosshair;display:block}
.bar{display:flex;align-items:center;gap:8px;font-size:.78rem;margin:3px 0}
.bar .lab{width:84px;color:var(--ink2);flex:none}.bar .track{flex:1;background:var(--chip);border-radius:4px;height:11px;position:relative}
.bar .fill{height:100%;border-radius:4px;background:var(--s1)}.bar .fill.b{background:var(--s2)}
.bar .val{width:84px;text-align:right;color:var(--muted);font-variant-numeric:tabular-nums;flex:none}
#vtip{position:fixed;pointer-events:none;background:#1c1c1b;color:#fff;font-size:.75rem;padding:5px 8px;border-radius:6px;display:none;z-index:50;max-width:260px}
@media (max-width:640px){.brand .sub{display:none}.kpi b{font-size:1.35rem}}
@media print{.top{position:static}.panel{display:block!important}.themebtn,.filters{display:none}}
</style>
<script>{{ plotly_js | safe }}</script>
<script>{{ cytoscape_js | safe }}</script>
</head>
<body>
<div class="top"><div class="wrap">
  <div class="brand"><h1>ccRCC Target Atlas</h1>
    <span class="sub">{{ f.disease.name }} · multi-omics GraphRAG · generated {{ f.generated_utc[:10] }} · config <code>{{ f.config_sha256[:8] }}</code></span></div>
  <div class="tabs" role="tablist">
    <button class="tab" role="tab" data-tab="overview">Overview</button>
    <button class="tab" role="tab" data-tab="candidates">Candidates</button>
    <button class="tab" role="tab" data-tab="omics">Omics</button>
    <button class="tab" role="tab" data-tab="cells">Cells &amp; space</button>
    <button class="tab" role="tab" data-tab="structure">Structure &amp; MGD</button>
    <button class="tab" role="tab" data-tab="discovery">Discovery<span class="n">{{ kpis.fic }}</span></button>
    <button class="tab" role="tab" data-tab="viewer">Tissue viewer</button>
    <button class="tab" role="tab" data-tab="response">Treatment &amp; subtypes</button>
    <button class="tab" role="tab" data-tab="adcimmune">ADC &amp; immune</button>
    <button class="tab" role="tab" data-tab="validation">Validation &amp; robustness</button>
    <button class="tab" role="tab" data-tab="literature">Literature &amp; drugs</button>
    <button class="tab" role="tab" data-tab="network">Network</button>
    <button class="tab" role="tab" data-tab="methods">Methods &amp; evidence</button>
  </div>
</div></div>

<main class="wrap">

<section class="panel" id="tab-overview" data-name="overview">
<p class="lede">{{ f.question }}</p>
{% include "whatsnew.html.j2" %}
<div class="kpis">
  <div class="kpi">{{ q("kpi_universe") }}<b>{{ "{:,}".format(kpis.universe) }}</b><span>genes scored</span></div>
  <div class="kpi">{{ q("kpi_claims") }}<b>{{ "{:,}".format(kpis.claims) }}</b><span>evidence-backed claims in the graph</span></div>
  <div class="kpi">{{ q("kpi_cells") }}<b>{{ "{:,}".format(kpis.cells) }}</b><span>single cells (scRNA-seq)</span></div>
  <div class="kpi">{{ q("kpi_spots") }}<b>{{ "{:,}".format(kpis.spots) }}</b><span>Visium spots</span></div>
  <div class="kpi">{{ q("kpi_proteins") }}<b>{{ kpis.proteins }}</b><span>AlphaFold models analysed</span></div>
  <div class="kpi">{{ q("kpi_fic") }}<b>{{ kpis.fic }}</b><span>first-in-class opportunities (of {{ kpis.pool }} screened)</span></div>
</div>
<h2>Summary</h2>
{% for p in f.narrative.summary %}
<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p.text }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
<h2>Prioritized candidates</h2>
<p class="small">Chosen by the orchestrator from the deterministic ranking and the verified agent reports; every rationale links to graph evidence.</p>
<div class="grid">
{% for t in f.targets %}{% set b = badges.get(t.gene, {}) %}
<div class="card cand claim" data-evidence="{{ t.evidence_ids | evattr }}">
  <h3>{{ loop.index }}. {{ t.gene }}</h3>
  <div class="meta">
    <span class="tag {{ {'target':'t','biomarker':'b','target_and_biomarker':'tb'}.get(t.category,'') }}">{{ t.category | replace("_"," ") }}</span>
    {% if b.rank %}<span class="tag">rank {{ b.rank }}</span>{% endif %}
    {% if b.cell_label %}<span class="tag">{{ b.cell_label }}{% if b.cell_share is not none %} {{ "%.0f" | format(b.cell_share * 100) }}%{% endif %}</span>{% endif %}
    {% if b.mgd %}<span class="tag">MGD {{ b.mgd }}</span>{% endif %}
    {% if b.drug %}<span class="tag fic">{{ b.drug }}</span>{% endif %}
  </div>
  <p>{{ t.rationale }} {{ t.evidence_ids | cite | safe }}</p>
</div>
{% endfor %}
</div>
</section>

<section class="panel" id="tab-candidates" data-name="candidates">
<h2>Deterministic convergence ranking</h2>
<p class="lede">Each gene gets one score built from seven kinds of evidence: how much it changes in tumour (RNA, protein and phospho), whether a copy-number change really moves its product, what the literature says, genetics, how druggable the protein looks, whether cancer cell lines need it, and whether a second cohort (TCGA-KIRC) sees the same change. Every kind is scaled from 0 to 1 and multiplied by a weight ({% for k, v in f.convergence.config.stream_weights.items() %}{{ k }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}). The weights live in <code>config.yaml</code> and were set before the results were known. {{ "{:,}".format(f.convergence.universe_size) }} genes are scored.</p>
<div class="grid two">
  {{ plot('stream_stack', figs.stream_stack) }}
  {{ plot('component_heatmap', figs.component_heatmap) }}
</div>
<h3>Top 25 {{ q('top25') }}</h3>
<div class="tw"><table>
<thead><tr><th>#</th><th>Gene</th><th>Score</th><th>Omics</th><th>CNV</th><th>Lit.</th><th>Genetics</th><th>Tract.</th><th>Dep.</th><th>Repl.</th><th>Rank 90 % interval</th>
<th>RNA log2FC</th><th>Protein log2FC</th><th>Drugs (max stage)</th><th>Evidence</th></tr></thead>
<tbody>
{% for r in top25 %}{% set ids = r.evidence_ids.omics + r.evidence_ids.cnv + r.evidence_ids.literature + r.evidence_ids.genetics + r.evidence_ids.tractability + (r.evidence_ids.dependency or []) + (r.evidence_ids.replication or []) %}
<tr class="claim" data-evidence="{{ ids | evattr }}">
<td>{{ r.rank }}</td><td><strong>{{ r.gene }}</strong></td>
<td class="num"><span class="score" style="width:{{ (r.score * 10) | round(0) | int }}px"></span>{{ r.score }}</td>
<td class="num">{{ r.components.omics }}</td><td class="num">{{ r.components.cnv }}</td><td class="num">{{ r.components.literature }}</td>
<td class="num">{{ r.components.genetics }}</td><td class="num">{{ r.components.tractability }}</td>
<td class="num">{{ r.components.dependency | fmt }}</td><td class="num">{{ r.components.replication | fmt }}</td>
<td class="num">{% if r.rank_interval_90 %}{{ r.rank_interval_90.rank_p05 }}–{{ r.rank_interval_90.rank_p95 }}{% else %}—{% endif %}</td>
<td class="num">{{ r.rna_log2fc | fmt }}</td><td class="num">{{ r.protein_log2fc | fmt }}</td>
<td>{% for d in r.drugs[:3] %}{{ d.name | title }} ({{ d.max_stage | replace("_"," ") | lower }}){% if not loop.last %}; {% endif %}{% endfor %}</td>
<td>{{ ids[:6] | cite | safe }}</td></tr>
{% endfor %}
</tbody></table></div>
{% if f.narrative.sections.integration %}<h3 style="margin-top:1.6em">Integration</h3>{% endif %}
{% for p in f.narrative.sections.integration or [] %}
<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p.text }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
</section>

<section class="panel" id="tab-omics" data-name="omics">
<h2>Omics evidence (CPTAC discovery cohort)</h2>
{% for p in f.narrative.sections.omics or [] %}
<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p.text }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
<div class="grid two">
  {{ plot('volcano_rna', figs.volcano_rna) }}{{ plot('volcano_protein', figs.volcano_protein) }}
  {{ plot('rna_vs_protein', figs.rna_vs_protein) }}{{ plot('arm_loss', figs.arm_loss) }}
</div>
<h3>Association with tumour grade {{ q('grade') }}</h3>
<p class="small">This shows how closely each gene follows tumour grade (G1 to G4) across the discovery tumours, for RNA and for protein. The CPTAC clinical file has grade, stage and tumour size but no survival, so grade is the only outcome-like measure available here. The survival analysis uses TCGA-KIRC instead.</p>
{{ plot('grade', figs.grade) }}
{% if f.agent_findings.omics %}<h3>Omics agent findings (verified)</h3>
{% for x in f.agent_findings.omics.findings %}
<p class="claim" data-evidence="{{ x.evidence_ids | evattr }}"><strong>{{ x.gene }}</strong> <span class="tag">{{ x.role | replace("_"," ") }}</span> {{ x.statement }} {{ x.evidence_ids | cite | safe }}</p>
{% endfor %}{% endif %}
</section>

<section class="panel" id="tab-cells" data-name="cells">
<h2>Which cells express each candidate?</h2>
<p class="lede">The cell-type calls come from single-cell data of Li et al. 2022: {{ "{:,}".format(cell.sc.cells_used) }} cells from {{ cell.sc.donors }} donors, {{ "{:,}".format(cell.sc.cells_by_tissue.tumor) }} of them from tumour tissue. "Share of tumour transcripts" is the part of a gene's tumour RNA that each cell type makes. It separates a gene the tumour cells make themselves from one whose signal comes from infiltrating cells. "Tumour cell vs proximal tubule" compares the cancer cells with the normal cell they most likely came from, donor by donor ({{ cell.sc.tumor_vs_pt_donors }} donors had both). The last block on this tab repeats the attribution in a second, independent dataset.</p>
{% for p in f.narrative.sections.cells or [] %}
<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p.text }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
<div class="grid two">
  {{ plot('dotplot', figs.dotplot) }}{{ plot('share_stack', figs.share_stack) }}
</div>
<div class="tw" style="margin-top:14px"><table>
<thead><tr><th>Gene</th><th>Highest-expressing cell type (mean)</th><th>% cells</th><th>Share of tumour transcripts</th><th>Tumour-cell share</th><th>τ</th>
<th>Tumour cell vs proximal tubule</th><th>Evidence</th></tr></thead><tbody>
{% for t in cell.cell_rows %}
<tr class="claim" data-evidence="{{ t.evidence_ids | evattr }}"><td><strong>{{ t.gene }}</strong></td>
<td>{{ t.top_label }} <span class="small">({{ t.top_group }})</span></td><td class="num">{{ t.top_pct }}</td><td class="num">{{ t.top_share }}</td>
<td class="num">{{ t.tumor_cell_share | fmt }}</td><td class="num">{{ t.tau | fmt }}</td>
<td class="num">{% if t.tvp %}log2FC {{ t.tvp.log2fc }} (padj {{ t.tvp.padj }}){% else %}—{% endif %}</td><td>{{ t.evidence_ids[:4] | cite | safe }}</td></tr>
{% endfor %}</tbody></table></div>

<h2>Does a second dataset agree?</h2>
{% set R = m15.sc_rep %}
{% if R %}<p class="lede">Zhang et al. 2021 profiled {{ R.zhang.tumour_donors }} ccRCC donors ({{ "{:,}".format(R.zhang.tumour_cells) }} cells) and {{ R.zhang.normal_donors }} normal kidneys, with {{ R.zhang.paired_donors }} donors in both. The two studies name cell types differently, so both were folded into seven shared groups. For genes in the discovery screen, the dominant source in Zhang matches the track from Li in {% for t, v in R.discovery_by_track.items() %}{{ v.same_track_in_zhang }} of {{ v.measured }} {{ t }} genes{% if not loop.last %}, {% endif %}{% endfor %}. Across {{ "{:,}".format(R.genes_compared) }} genes the tumour-cell share correlates between studies at rho {{ R.rcc_share_spearman }}, and the tumour-versus-tubule fold change at rho {{ R.tvp_log2fc_spearman }}. Immune genes agree least: the two studies capture very different amounts of immune cells.</p>
<div class="grid two">
  {{ plot('sc_replication', figs.sc_replication) }}
  <div class="tw"><table><thead><tr><th>Gene</th><th>Li 2022 source</th><th>Zhang 2021 source</th><th>Tumour share Li</th><th>Tumour share Zhang</th></tr></thead><tbody>
  {% for r in m15.sc_rep_targets %}<tr><td><strong>{{ r.gene }}</strong></td><td>{{ r.li_top }}</td><td>{{ r.zhang_top }}</td><td class="num">{{ r.li_rcc_share }}</td><td class="num">{{ r.zhang_rcc_share }}</td></tr>{% endfor %}
  </tbody></table></div>
</div>{% endif %}

<h2>Where are they in the tissue?</h2>
<p class="lede">The tissue data are {{ "{:,}".format(cell.spatial.spots) }} Visium spots from {{ cell.spatial.sections }} sections and {{ cell.spatial.donors }} donors. Each spot mixes a few cells, so its cell makeup is estimated by fitting it to the study's own single-cell profiles. The candidate genes were left out of that fit, which makes them a fair test of it: CA9 follows the tumour-cell share (rho {{ cell.spatial.validation.spearman_CA9_vs_RCC }}), KDR follows endothelium ({{ cell.spatial.validation.spearman_KDR_vs_Endothelial }}), CD74 follows macrophages ({{ cell.spatial.validation.spearman_CD74_vs_Macrophage }}) and PTPRC follows T cells ({{ cell.spatial.validation.spearman_PTPRC_vs_T_cell }}). The correlations are positive but modest. The Tissue viewer tab shows the same data on the real H&E sections.</p>
{% for p in f.narrative.sections.spatial or [] %}
<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p.text }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
{% if figs.map_core or figs.map_interface %}
<p class="small">Use the menu above each map to pick a cell share or a candidate gene. These are the largest core and interface sections.</p>
<div class="grid two">
  {{ plot('map_core', figs.map_core) }}
  {{ plot('map_interface', figs.map_interface) }}
</div>{% endif %}
{{ plot('neighbors', figs.neighbors) }}
<p class="small">For each gene, we take the top tenth of spots and look at the ring of six spots around each one (about 100 micrometres). We compare the cell makeup of those rings with rings around random spots from the same sections, as a ratio, so common cell types get no head start. A permutation test with 1,000 shuffles gives each p-value, adjusted over all genes and cell types.</p>
<div class="tw"><table>
<thead><tr><th>Gene</th><th>In situ expresser (NNLS)</th><th>Composition-corrected source</th><th>High spots</th><th>Enriched neighbours (log₂ obs/exp, padj &lt; 0.05)</th><th>Evidence</th></tr></thead><tbody>
{% for t in cell.spatial_rows %}
<tr class="claim" data-evidence="{{ t.evidence_ids | evattr }}"><td><strong>{{ t.gene }}</strong></td><td>{{ t.top_expresser | fmt }}</td><td>{{ t.corrected | fmt }}</td>
<td class="num">{{ t.n_high }}</td>
<td>{% for e in t.neighbors %}{{ e.cell_group }} {{ "%+.2f"|format(e.log2_enrichment) }}{% if not loop.last %} · {% endif %}{% endfor %}{% if not t.neighbors %}—{% endif %}</td>
<td>{{ t.evidence_ids[:4] | cite | safe }}</td></tr>
{% endfor %}</tbody></table></div>
{% if f.agent_findings.cells %}<h3>Cell-context agent findings (verified)</h3>
{% for x in f.agent_findings.cells.findings %}
