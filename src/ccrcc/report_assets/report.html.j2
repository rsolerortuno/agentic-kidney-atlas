  {{ plot('tcga', figs.tcga) }}
  {{ plot('purity', figs.purity) }}
  {{ plot('mutations', figs.mutations) }}
  {{ plot('dependency', figs.dependency) }}
  {{ plot('kinases', figs.kinases) }}
</div>

<h2>Two questions, two scores</h2>
<p class="small">The overall score mixes target and biomarker evidence, so there are two separate profiles. The <strong>target</strong> profile weighs ({% for k, v in profile_weights.target.items() %}{{ k | replace("_", " ") }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}). The <strong>biomarker</strong> profile weighs ({% for k, v in profile_weights.biomarker.items() %}{{ k | replace("_", " ") }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}). Neither uses literature or drug history, which lets us test them against clinical outcomes below without the answer leaking into the score.</p>
{% for name in ["target", "biomarker"] %}{% if profiles[name] %}
<h3>{{ name | capitalize }} profile — top 25</h3>
<div class="tw"><table>
<thead><tr><th>#</th><th>Gene</th><th>Score</th>{% for k in profile_weights[name] %}<th>{{ k | replace("_", " ") }}</th>{% endfor %}<th>Rank 90 % interval</th><th>P(top 10)</th><th>Evidence</th></tr></thead>
<tbody>{% for r in profiles[name] %}{% set allids = [] %}{% for v in r.evidence_ids.values() %}{% for i in v %}{% set _ = allids.append(i) %}{% endfor %}{% endfor %}
<tr class="claim" data-evidence="{{ allids | evattr }}"><td>{{ r.rank }}</td><td><strong>{{ r.gene }}</strong></td><td class="num">{{ r.score }}</td>
{% for k in profile_weights[name] %}<td class="num">{{ r.components[k] | fmt }}</td>{% endfor %}
<td class="num">{% if r.rank_interval_90 %}{{ r.rank_interval_90.rank_p05 }}–{{ r.rank_interval_90.rank_p95 }}{% else %}—{% endif %}</td>
<td class="num">{% if r.rank_interval_90 %}{{ r.rank_interval_90.p_top10 }}{% else %}—{% endif %}</td>
<td>{{ allids[:6] | cite | safe }}</td></tr>
{% endfor %}</tbody></table></div>
{% endif %}{% endfor %}

<h2>Robustness to the weights</h2>
{% for p in f.narrative.sections.robustness or [] %}
<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p.text }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
<p class="small">Each ranking is recomputed 1,000 times with weights drawn at random around the chosen ones. Dots are median ranks and bars cover the 5th to 95th percentile. A short bar near the top means the gene stays there whatever the weights.</p>
